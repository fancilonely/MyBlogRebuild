# build output
dist/

# integration cache (esbuild config bundles, plugin-mode font subsets)
.shirones/

# Scratch directories the packaging pipeline creates when it transpiles the
# theme's TypeScript generators. They should never survive a run; the pattern
# is here so that an aborted one cannot reach a commit.
.shirones-ts-*/

# content repository working copy, provenance, and safe cleanup backups
.content-src/
.content-backup/
content.lock.json
Shirone-Content/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

.vercel

package-lock.json
bun.lockb
yarn.lock

# ide
.idea

# generated font subsets
src/assets/fonts/.subset/

# generated local icon collection
src/generated/local-icon-collections.ts
*.iml

# anime snapshot data & downloaded covers
src/data/anime-snapshots/*.json
public/assets/anime/covers/*
!public/assets/anime/covers/.gitkeep

# generated responsive moment thumbnails
public/assets/moments/thumbnails/*
!public/assets/moments/thumbnails/.gitkeep

# local tooling artifacts
.zcode/
.codex-*.log
research/

# playwright
.playwright-cli/
test-results/
playwright-report/
tests/site/visual.spec.ts-snapshots/

# Lighthouse local reports
artifacts/lighthouse/*
!artifacts/lighthouse/.gitkeep
.lighthouseci/

# generated AI skills plugin packages
artifacts/shirone-ai-*

# ---------------------------------------------------------------------------
# FancyTowa: migration workspace safety net
# ---------------------------------------------------------------------------
# Raw exports and intermediate data from the old WordPress site. These live in
# the workspace root, outside this repository; the entries below are a guard so
# that copying one in by accident can never reach a commit.
private-backups/
migration-input/
migration_staging/
tieba/

# databases and archives exported from the old site
*.sql
*.sql.gz
*.zip
*.tar.gz

# migration reports, handoff notes and validation output
MIGRATION_AUDIT.md
REBUILD_SUMMARY.md
THEME_CLEANUP_REPORT.md
BROKEN_ASSETS.md
HANDOFF_PROMPT.md
validation.json

# transient generator output that must not be committed
src/generated/*.tmp

# ---------------------------------------------------------------------------
# 代码与个人内容分离（Code / Content separation）
# ---------------------------------------------------------------------------
# 个人文章、说说、文章配图与备份只保留在本地，绝不进入版本库；
# 仅放行一份最小可运行示例，保证 clone 后 `pnpm dev` / `pnpm build` 直接可用。
# 说明：`private-backups/` 与 `BROKEN_ASSETS.md` 已在上面的安全网段落中忽略。
src/content/posts/*
!src/content/posts/hello-world.md
src/content/moments/*
!src/content/moments/.gitkeep
src/content/spec/*
!src/content/spec/about.md
public/images/*
!public/images/.gitkeep

# 个人头像：只留在本地，公开仓库保留主题默认占位图
# （头像路径在 src/config/profileConfig.ts 的 avatar 字段，换成你自己的图片即可）
src/assets/images/Fancyprofile.webp
